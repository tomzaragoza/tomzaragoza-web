MONGODB_URL=
MONGODB_DB=tomzaragoza
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostHog browser analytics. The project token and host are public values.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=

# Stripe-hosted checkout for the X Ads course presale.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Optional. The current live presale price is used when this is blank.
STRIPE_X_ADS_PRESALE_PRICE_ID=

# Existing admin and MCP access tokens. Set both explicitly in production.
TOMZARAGOZA_ADMIN_TOKEN=
TOMZARAGOZA_MCP_TOKEN=
