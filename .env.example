MONGODB_URL=
MONGODB_DB=tomzaragoza
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostHog browser analytics. The project token and host are public values.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=

# X Ads base Pixel ID. This is a public browser value.
# Checkout and purchase event IDs are fixed in the application.
NEXT_PUBLIC_X_PIXEL_ID=o6ml8

# Stripe-hosted checkout for the X Ads course presale.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Prices are set in lib/x-ads-offer.ts: $20/$99 through October 16, 2026,
# then $49/$198. Stripe Checkout uses the same values in USD.

# PayPal Checkout for the same course prices. Use a webhook for capture and refund events.
PAYPAL_API_KEY=
PAYPAL_SECRET_KEY=
PAYPAL_ENVIRONMENT=live
PAYPAL_WEBHOOK_ID=

# Existing admin and MCP access tokens. Set both explicitly in production.
TOMZARAGOZA_ADMIN_TOKEN=
TOMZARAGOZA_MCP_TOKEN=

# Private X Ads course media in DigitalOcean Spaces.
DO_SPACES_BUCKET=main003
DO_SPACES_REGION=tor1
DO_SPACES_ENDPOINT=https://tor1.digitaloceanspaces.com
DO_SPACES_ORIGIN=https://main003.tor1.digitaloceanspaces.com
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=
