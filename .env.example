MONGODB_URL=
MONGODB_DB=tomzaragoza
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostHog browser analytics. The project token and host are public values.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=

# X Ads Pixel identifiers. These are public browser values.
# The app uses these IDs by default. Set them only to use a different X Pixel.
NEXT_PUBLIC_X_PIXEL_ID=o6ml8
NEXT_PUBLIC_X_CHECKOUT_EVENT_ID=tw-o6ml8-rfgj8
NEXT_PUBLIC_X_PURCHASE_EVENT_ID=tw-o6ml8-rfgj9

# Stripe-hosted checkout for the X Ads course presale.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Prices are set in lib/x-ads-offer.ts: $20/$99 until September 30, 2026,
# then $49/$198. Stripe Checkout uses the same values in USD.

# PayPal Checkout for the same course prices. Use a webhook for capture and refund events.
PAYPAL_API_KEY=
PAYPAL_SECRET_KEY=
PAYPAL_ENVIRONMENT=live
PAYPAL_WEBHOOK_ID=

# Existing admin and MCP access tokens. Set both explicitly in production.
TOMZARAGOZA_ADMIN_TOKEN=
TOMZARAGOZA_MCP_TOKEN=
